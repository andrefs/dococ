# dococ project configuration
# Generated by analyzing the dococ project (Bash + Docker wrapper for opencode)

# -----------------------------------------------------------------------------
# System packages (apt)
# -----------------------------------------------------------------------------
# The base Dockerfile already installs: ca-certificates, curl, tar, git, nodejs, npm
# Add development tools for working on the dococ script itself:
DOCOC_APT_PACKAGES=(
    shellcheck      # Bash linting
    bats            # Bash testing framework
    # docker.io     # Uncomment if you need docker inside the container for nested builds
)

# -----------------------------------------------------------------------------
# Extra mounts
# -----------------------------------------------------------------------------
# This project is self-contained. No additional project-specific mounts needed.
# Default mounts already provide:
#   - $PWD -> /workspace (project source, read-write)
#   - ~/.config/opencode -> ~/.config/opencode (read-only)
#   - ~/.local/share/opencode -> ~/.local/share/opencode (read-write)
#   - ~/.local/state/opencode -> ~/.local/state/opencode (read-write)
#   - ~/.cache/opencode -> ~/.cache/opencode (read-write)
#   - ~/.agents -> ~/.agents (read-only)
# SECURITY: Only mount what is clearly project-related. Avoid ~/.ssh, ~/.gnupg, /etc, etc.
# DOCOC_MOUNTS=()

# -----------------------------------------------------------------------------
# Extra mount files (read-only)
# -----------------------------------------------------------------------------
# Individual files to mount read-only. Example for git config:
# DOCOC_MOUNT_FILES=(
#   "$HOME/.gitconfig:/home/ubuntu/.gitconfig:ro"
# )

# -----------------------------------------------------------------------------
# Environment variables
# -----------------------------------------------------------------------------
DOCOC_ENV=(
    "EDITOR=vim"           # Default editor for config editing
    "SHELLCHECK_OPTS=-e SC2148"  # shellcheck: ignore "tip: add shebang" for sourced files
    # "DOCOC_OFFLINE=0"     # Set to 1 for --network none (no internet)
    # "DOCOC_REMOVE=0"      # Set to 1 to auto-remove container on exit (--rm)
    # "DOCOC_ISOLATED=0"    # Set to 1 for per-project opencode data isolation
)

# -----------------------------------------------------------------------------
# Opencode data isolation
# -----------------------------------------------------------------------------
# DOCOC_ISOLATED=1  # Uncomment to use per-project opencode data dir

# -----------------------------------------------------------------------------
# Network
# -----------------------------------------------------------------------------
# DOCOC_OFFLINE=1   # Uncomment to run with --network none

# -----------------------------------------------------------------------------
# Container lifecycle
# -----------------------------------------------------------------------------
# DOCOC_REMOVE=1    # Uncomment to remove container when session ends (--rm)
# DOCOC_KEEP=1      # Explicit keep (default)