#!/bin/bash
#
# dococ — run opencode inside a Docker container with relevant folders mounted.
#
# See README.md and PLAN.md for the full design. This file is split into
# sections; unimplemented behaviors are stubbed until their step lands.

set -euo pipefail

# ---------------------------------------------------------------------------
# Configuration and defaults
# ---------------------------------------------------------------------------

DOCOC_VERSION="0.1.0"

DOCOC_IMAGE_DEFAULT="dococ/opencode:latest"
DOCOC_WORKDIR=""
# Home directory inside the container. All host state (opencode dirs, agents
# skills) is mounted under this path so opencode reads it via $HOME, and the
# host username never appears inside the container.
DOCOC_CONTAINER_HOME="${DOCOC_CONTAINER_HOME:-/home/ubuntu}"
# Bump when the mount layout changes so existing containers are recreated.
DOCOC_MOUNT_VERSION="4"

# Container-side destinations for opencode's state dirs and agent skills. These
# are fixed so the containerized opencode (HOME=$DOCOC_CONTAINER_HOME) reads
# them; only the host *source* changes under --isolated.
DOCOC_C_CONFIG="$DOCOC_CONTAINER_HOME/.config/opencode"
DOCOC_C_DATA="$DOCOC_CONTAINER_HOME/.local/share/opencode"
DOCOC_C_STATE="$DOCOC_CONTAINER_HOME/.local/state/opencode"
DOCOC_C_CACHE="$DOCOC_CONTAINER_HOME/.cache/opencode"
DOCOC_C_AGENTS="$DOCOC_CONTAINER_HOME/.agents"

# Locations on the host that hold opencode state.
DOCOC_OPENCODE_CONFIG="${DOCOC_OPENCODE_CONFIG:-$HOME/.config/opencode}"
DOCOC_OPENCODE_DATA="${DOCOC_OPENCODE_DATA:-$HOME/.local/share/opencode}"
DOCOC_OPENCODE_STATE="${DOCOC_OPENCODE_STATE:-$HOME/.local/state/opencode}"
DOCOC_OPENCODE_CACHE="${DOCOC_OPENCODE_CACHE:-$HOME/.cache/opencode}"
# Host directory holding skills (and other agent assets) exposed read-only.
DOCOC_AGENTS_DIR="${DOCOC_AGENTS_DIR:-$HOME/.agents}"

# dococ's own runtime roots.
DOCOC_CONFIG_DIR="${DOCOC_CONFIG_DIR:-$HOME/.config/dococ}"
DOCOC_DATA_DIR="${DOCOC_DATA_DIR:-$HOME/.local/share/dococ}"

# User can override image and container naming via environment/config.
# Track if explicitly set in environment (before default).
DOCOC_IMAGE_EXPLICIT=0
if [[ -v DOCOC_IMAGE ]]; then
    DOCOC_IMAGE_EXPLICIT=1
fi
DOCOC_IMAGE="${DOCOC_IMAGE:-$DOCOC_IMAGE_DEFAULT}"

# Additional apt packages to install in the per-project image.
# Populated from global and per-project config files.
declare -a DOCOC_APT_PACKAGES=()

# Setup commands to run at build time (LSP installs, tool setup, etc.).
# Populated from global and per-project config files.
declare -a DOCOC_SETUP_COMMANDS=()

# CLI-resolved options (populated by the parser).
declare -a DOCOC_MOUNTS=()
declare -a DOCOC_MOUNT_FILES=()
declare -a DOCOC_ENV=()
DOCOC_ISOLATED=0
DOCOC_NEW=0
DOCOC_REPLACE=0
DOCOC_PICK=0
DOCOC_PICK_NAME=""
DOCOC_REMOVE=0
DOCOC_OFFLINE=0
DOCOC_COMMAND=""
declare -a core_mounts=()

# ---------------------------------------------------------------------------
# Helpers
# ---------------------------------------------------------------------------

stderr() { printf 'dococ: %s\n' "$*" >&2; }

die() {
    stderr "$*"
    exit 1
}

# Render usage/help text.
usage() {
    cat <<EOF
dococ ${DOCOC_VERSION} — run opencode inside a Docker container.

Usage:
  dococ [options] [--command CMD]
  dococ init
  dococ list
  dococ status
  dococ clean
  dococ update
  dococ gen-config
  dococ images

With no subcommand, dococ opens (or reuses) a container for the current
project and launches opencode inside it.

Options:
  -m, --mount PATH       Mount an extra folder into the container (repeatable).
      --mount-file PATH  Mount an individual file (repeatable).
  -e, --env KEY=VAL      Set an environment variable in the container (repeatable).
      --isolated         Use a per-project opencode data dir instead of the
                         shared database.
  -n, --new              Create a fresh container; keep the existing one
                         (retired under a new name).
      --replace          Destroy the existing container(s) for this project,
                         then create a fresh one.
      --pick [NAME]      Choose a container to use. With NAME, use that
                         container directly; without it, list this project's
                         containers and interactively pick one (one-shot;
                         canonical name unchanged).
      --rm               Remove the container when the session ends (default: keep).
      --keep             Keep the container on exit (explicit; the default).
      --offline          Run with --network none (no network access at all).
      --command CMD      Run CMD in a one-off container instead of opencode.
      --config-file PATH Per-project config file (default: ./.dococ).
      --global-config PATH Global config file (default: ~/.config/dococ/config.sh).
      --output PATH      Output file for gen-config (default: ./.dococ).
  -h, --help             Show this help and exit.
  -v, --version          Show version and exit.

Subcommands:
  init         Initialize project: generate config, build image.
  list         List this project's containers.
  status       List all dococ containers.
  clean        Remove all dococ containers.
  update       Rebuild the dococ image from the current opencode binary.
  gen-config   Generate a .dococ config by analyzing the project with opencode.
  images       List all dococ container images.
EOF
}

# ---------------------------------------------------------------------------
# Config file paths (can be overridden by CLI)
DOCOC_PROJECT_CONFIG="${DOCOC_PROJECT_CONFIG:-$PWD/.dococ}"
DOCOC_GLOBAL_CONFIG="${DOCOC_GLOBAL_CONFIG:-$HOME/.config/dococ/config.sh}"
DOCOC_GEN_CONFIG_OUTPUT="${DOCOC_GEN_CONFIG_OUTPUT:-$PWD/.dococ}"

# Embedded Dockerfile content - written to config dir on first run
DOCKERFILE_CONTENT='# dococ — opencode runtime image.
#
# Builds a container with opencode installed via the official install script
# (`curl -fsSL https://opencode.ai/install | bash`), so the binary is always the
# latest release. Project folders and opencode state are mounted at run time.
#
#   docker build -t dococ/opencode:<project-hash> \
#     --build-arg APT_PACKAGES="cargo golang" \
#     --build-arg SETUP_COMMANDS="rustup component add rust-analyzer" .

# Volatile tag so the image tracks the environment it builds in.
FROM ubuntu:24.04

# Build arg for additional apt packages (space-separated)
ARG APT_PACKAGES=""

# Build arg for setup commands (newline-separated, run as ubuntu user)
# Example: SETUP_COMMANDS="rustup component add rust-analyzer\ncargo install cargo-watch"
ARG SETUP_COMMANDS=""

# Base tooling: curl/tar for the installer, git for coding agents, ca-certificates
# for HTTPS, and node/npm for opencode plugins and MCP servers (e.g. @playwright/mcp).
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        ca-certificates \
        curl \
        tar \
        git \
        nodejs \
        npm \
    && if [ -n "$APT_PACKAGES" ]; then \
        apt-get install -y --no-install-recommends $APT_PACKAGES; \
    fi \
    && rm -rf /var/lib/apt/lists/*

# Ubuntu'"'"'s base image ships a user "ubuntu" created with the first available UID
# (1000 on x86_64). We reuse it, so the container'"'"'s default user matches the
# common host UID 1000. dococ additionally passes --user $(id -u):$(id -g) at run
# time, so mounted files match the host owner regardless of the image'"'"'s UID.
#
# Install the latest opencode binary into the ubuntu user'"'"'s home.
# --no-modify-path: we set PATH explicitly via ENV rather than editing a shell rc.
ENV OPENCODE_USER=ubuntu \
    OPENCODE_HOME=/home/ubuntu \
    PATH="/home/ubuntu/.opencode/bin:/home/ubuntu/.cargo/bin:/home/ubuntu/.npm-global/bin:/home/ubuntu/go/bin:/home/ubuntu/.local/bin:${PATH}"

RUN mkdir -p "$OPENCODE_HOME/.opencode" \
    && chown -R "$OPENCODE_USER":"$OPENCODE_USER" "$OPENCODE_HOME" \
    && runuser -u "$OPENCODE_USER" -- bash -c \
        "curl -fsSL https://opencode.ai/install | bash -s -- --no-modify-path"

# Run user-provided setup commands (LSP installs, etc.) as the ubuntu user.
# Commands are newline-separated in the SETUP_COMMANDS build arg.
RUN if [ -n "$SETUP_COMMANDS" ]; then \
        printf '"'"'%b'"'"' "$SETUP_COMMANDS" | while IFS= read -r cmd; do \
            [ -n "$cmd" ] && runuser -u "$OPENCODE_USER" -- bash -lc "$cmd"; \
        done; \
    fi

# Convenience workspace mount point referenced by dococ at run time.
RUN mkdir -p /workspace && chown "$OPENCODE_USER":"$OPENCODE_USER" /workspace

# Default to the ubuntu user. dococ overrides this with --user $(id -u):$(id -g)
# so files written into mounted project folders match the host owner.
USER ubuntu
WORKDIR /workspace

# dococ launches opencode interactively via `docker exec`; CMD here is a fallback.
CMD ["opencode"]'

# Ensure config directory exists with Dockerfile
ensure_config_dir() {
    mkdir -p "$DOCOC_CONFIG_DIR"
    if [[ ! -f "$DOCOC_CONFIG_DIR/Dockerfile" ]]; then
        printf '%s\n' "$DOCKERFILE_CONTENT" > "$DOCOC_CONFIG_DIR/Dockerfile"
        stderr "wrote Dockerfile to $DOCOC_CONFIG_DIR/Dockerfile"
    fi
}

# Config loading
# ---------------------------------------------------------------------------

# Load a dococ config file if present. Files are Bash scripts that may set
# DOCOC_* variables and append to DOCOC_MOUNTS / DOCOC_ENV / DOCOC_MOUNT_FILES.
load_config() {
    local f="$1"
    [[ -f "$f" ]] || return 0
    # shellcheck disable=SC1090
    source "$f"
}

# ---------------------------------------------------------------------------
# Argument parsing
# ---------------------------------------------------------------------------

parse_args() {
    local arg
    while (($#)); do
        arg="$1"
        case "$arg" in
            -h|--help)
                usage
                exit 0
                ;;
            -v|--version)
                echo "dococ ${DOCOC_VERSION}"
                exit 0
                ;;
            -m|--mount)
                shift || true
                [[ $# -ge 1 ]] || die "option '$arg' requires an argument"
                DOCOC_MOUNTS+=("$1")
                ;;
            --mount-file)
                shift || true
                [[ $# -ge 1 ]] || die "option '$arg' requires an argument"
                DOCOC_MOUNT_FILES+=("$1")
                ;;
            -e|--env)
                shift || true
                [[ $# -ge 1 ]] || die "option '$arg' requires an argument"
                DOCOC_ENV+=("$1")
                ;;
            --isolated)
                DOCOC_ISOLATED=1
                ;;
            -n|--new)
                DOCOC_NEW=1
                ;;
            --replace)
                DOCOC_REPLACE=1
                ;;
            --pick)
                DOCOC_PICK=1
                # Optional explicit selection: `--pick NAME` where NAME is one
                # of this project's container names. Omit it to choose
                # interactively. A bare `dococ-` token is treated as the name.
                if [[ $# -ge 2 && "$2" == dococ-* ]]; then
                    DOCOC_PICK_NAME="$2"
                    shift
                else
                    DOCOC_PICK_NAME=""
                fi
                ;;
            --rm)
                DOCOC_REMOVE=1
                ;;
            --keep)
                DOCOC_REMOVE=0
                ;;
            --offline)
                DOCOC_OFFLINE=1
                ;;
            --config-file)
                shift || true
                [[ $# -ge 1 ]] || die "option '$arg' requires an argument"
                DOCOC_PROJECT_CONFIG="$1"
                ;;
            --global-config)
                shift || true
                [[ $# -ge 1 ]] || die "option '$arg' requires an argument"
                DOCOC_GLOBAL_CONFIG="$1"
                ;;
            --output)
                shift || true
                [[ $# -ge 1 ]] || die "option '$arg' requires an argument"
                DOCOC_GEN_CONFIG_OUTPUT="$1"
                ;;
            --command)
                shift || true
                [[ $# -ge 1 ]] || die "option '$arg' requires an argument"
                DOCOC_COMMAND="$1"
                ;;
            list|status|clean|update|gen-config|images|init)
                # Subcommand dispatch happens after parsing.
                DOCOC_SUBCOMMAND="${arg}"
                ;;
            -*)
                die "unknown option: $arg (see 'dococ --help')"
                ;;
            *)
                die "unexpected argument: $arg (see 'dococ --help')"
                ;;
        esac
        shift
    done
}

# ---------------------------------------------------------------------------
# Subcommands (stubbed until their step lands)
# ---------------------------------------------------------------------------

# List all dococ-managed containers (identified by their dococ.project label).
list_dococ_containers() {
    docker ps -a --filter "label=dococ.project" --format '{{.Names}}'
}

do_status() {
    command -v docker >/dev/null 2>&1 || die "docker not found in PATH"

    local name project running header=1
    mapfile -t names < <(list_dococ_containers)
    for name in "${names[@]}"; do
        [[ -n "$name" ]] || continue
        project="$(docker inspect -f '{{index .Config.Labels "dococ.project"}}' "$name" </dev/null)"
        if [[ "$(docker inspect -f '{{.State.Running}}' "$name" </dev/null)" == "true" ]]; then
            running="running"
        else
            running="stopped"
        fi
        if ((header)); then
            printf '%-42s %-8s %s\n' "CONTAINER" "STATE" "PROJECT"
            header=0
        fi
        printf '%-42s %-8s %s\n' "$name" "$running" "$project"
    done

    [[ $header -eq 1 ]] && stderr "no dococ containers"
}

# List this project's containers (the canonical one is marked). The canonical
# name is what a plain `dococ` reuses; the rest are retired `--new` containers
# or would-be replacements.
do_list() {
    command -v docker >/dev/null 2>&1 || die "docker not found in PATH"

    local project name canonical state header=1
    project="$(pwd)"
    canonical="$(project_container_name "$project")"

    mapfile -t names < <(project_containers "$project")
    if (( ${#names[@]} )); then
        for name in "${names[@]}"; do
            [[ -n "$name" ]] || continue
            state="$(container_state "$name")"
            if [[ "$name" == "$canonical" ]]; then
                printf '%-42s %-8s %-9s %s\n' "$name" "$state" "(canonical)" "$project"
            else
                printf '%-42s %-8s %-9s %s\n' "$name" "$state" "-" "$project"
            fi
            header=0
        done
    else
        stderr "no containers for this project"
    fi
}

# List all dococ images (per-project and base).
do_images() {
    command -v docker >/dev/null 2>&1 || die "docker not found in PATH"

    docker images --format '{{.Repository}}:{{.Tag}}\t{{.Size}}\t{{.CreatedAt}}' \
        'dococ/opencode:*' 2>/dev/null | sort || \
        stderr "no dococ images found"
}

do_clean() {
    command -v docker >/dev/null 2>&1 || die "docker not found in PATH"

    local name count=0
    mapfile -t names < <(list_dococ_containers)
    for name in "${names[@]}"; do
        [[ -n "$name" ]] || continue
        stderr "removing container '$name'"
        docker rm -f "$name" >/dev/null </dev/null
        count=$((count + 1))
    done

    if ((count)); then
        stderr "removed $count dococ container(s)"
    else
        stderr "no dococ containers to remove"
    fi
}

# Generate .dococ config by running opencode to analyze the project.
do_gen_config() {
    local project_dir="${PWD}"
    local config_file="${DOCOC_GEN_CONFIG_OUTPUT}"
    local prompt
    local example_url="https://raw.githubusercontent.com/andrefs/dococ/main/dococ.example"

    if [[ -f "$config_file" ]]; then
        read -r -p "$config_file already exists. Overwrite? [y/N] " ans
        [[ "$ans" =~ ^[Yy]$ ]] || { stderr "aborted"; return 0; }
    fi

    # First, prompt user for extra mounts and mount-files
    local mounts=()
    local mount_files=()

    echo
    stderr "Default mounts already include: project dir, opencode config/data/state/cache, agents."
    stderr "You can add extra mounts now (e.g., for shared data, credentials, tools)."
    stderr "Press Enter to skip, or enter mount spec (host_path[:container_path][:ro])."

    while true; do
        read -r -p "Extra mount (or empty to finish)? " mount
        [[ -n "$mount" ]] || break
        mounts+=("$mount")
    done

    stderr "Extra mount-files (read-only individual files). Press Enter to skip."
    while true; do
        read -r -p "Extra mount-file (host_file[:container_path]) or empty to finish? " mount
        [[ -n "$mount" ]] || break
        mount_files+=("$mount")
    done

    # Build the prompt for opencode
    local mount_str=""
    if (( ${#mounts[@]} )); then
        mount_str="User requested extra mounts:\n"
        for m in "${mounts[@]}"; do
            mount_str+="  $m\n"
        done
    fi
    local mount_file_str=""
    if (( ${#mount_files[@]} )); then
        mount_file_str="User requested extra mount-files:\n"
        for m in "${mount_files[@]}"; do
            mount_file_str+="  $m\n"
        done
    fi

    prompt="Analyze this project and create a .dococ config file at $config_file.

$mount_str$mount_file_str

Requirements:
1. Detect project type (Node.js, Python, Rust, Go, etc.)
2. Recommend system dependencies (apt packages) in DOCOC_APT_PACKAGES
3. Suggest useful environment variables in DOCOC_ENV
4. Set DOCOC_OFFLINE, DOCOC_REMOVE as appropriate
6. DO NOT set DOCOC_ISOLATED=true unless the user explicitly requests isolation. Default to DOCOC_ISOLATED=false (shared opencode database across host and container sessions).
7. Include the user's extra mounts/mount-files in DOCOC_MOUNTS and DOCOC_MOUNT_FILES
8. Recommend language server installation commands in DOCOC_SETUP_COMMANDS (e.g., rustup component add rust-analyzer, go install golang.org/x/tools/gopls@latest, npm i -g typescript-language-server, pip install pyright, cargo install lua-language-server). These run at build time as the ubuntu user.
9. Use exact dococ variable names as bash arrays:
   - DOCOC_APT_PACKAGES=(pkg1 pkg2)
   - DOCOC_MOUNTS=(\"src:dst:ro\" ...)
   - DOCOC_MOUNT_FILES=(\"src:dst:ro\" ...)
   - DOCOC_ENV=(KEY=VALUE ...)
   - DOCOC_SETUP_COMMANDS=(\"cmd1\" \"cmd2\" ...)
10. Add explanatory comments

SECURITY CONSTRAINTS:
- NEVER mount ~/.ssh, ~/.gnupg, /etc, /, or other sensitive directories
- Only mount directories that are clearly project-related and safe
- Prefer read-only mounts where possible (use :ro suffix)
- Minimize mounts - less is more secure
- DO NOT output any secrets, tokens, keys, or sensitive paths

Reference the full list of available config variables at: $example_url

Write the config directly to $config_file. Your analysis/thinking will be shown to the user automatically."

    stderr "analyzing project with opencode..."
    opencode run "$prompt" --thinking </dev/null || {
        stderr "opencode analysis failed"
        return 1
    }

    if [[ -f "$config_file" ]]; then
        stderr "generated $config_file"
    else
        stderr "warning: opencode did not create $config_file"
    fi
}

do_update() {
    local script_dir dockerfile apt_packages setup_commands

    # Ensure config directory with Dockerfile exists
    ensure_config_dir

    # Find Dockerfile: check script dir, config dir, then cwd
    script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
    if [[ -f "$script_dir/Dockerfile" ]]; then
        dockerfile="$script_dir/Dockerfile"
    elif [[ -f "$DOCOC_CONFIG_DIR/Dockerfile" ]]; then
        dockerfile="$DOCOC_CONFIG_DIR/Dockerfile"
    elif [[ -f "$PWD/Dockerfile" ]]; then
        dockerfile="$PWD/Dockerfile"
    else
        die "Dockerfile not found in script dir ($script_dir), config dir ($DOCOC_CONFIG_DIR), or cwd ($PWD)"
    fi

    command -v docker >/dev/null 2>&1 || die "docker not found in PATH"

    # Join apt packages array into space-separated string for build arg
    apt_packages="${DOCOC_APT_PACKAGES[*]}"
    
    # Join setup commands array into newline-separated string for build arg
    # Use printf to handle newlines properly
    if (( ${#DOCOC_SETUP_COMMANDS[@]} > 0 )); then
        setup_commands=$(printf '%s\n' "${DOCOC_SETUP_COMMANDS[@]}")
    else
        setup_commands=""
    fi
    
    stderr "building image '$DOCOC_IMAGE' with apt packages: ${apt_packages:-<none>}..."
    if [[ -n "$setup_commands" ]]; then
        stderr "  setup commands: ${#DOCOC_SETUP_COMMANDS[@]} command(s)"
    fi
    docker build \
        --build-arg "APT_PACKAGES=${apt_packages}" \
        --build-arg "SETUP_COMMANDS=${setup_commands}" \
        -t "$DOCOC_IMAGE" -f "$dockerfile" "$script_dir"
    stderr "image '$DOCOC_IMAGE' built"
}

# Initialize a new project: generate config and build image.
do_init() {
    local config_file="${DOCOC_GEN_CONFIG_OUTPUT}"

    if [[ -f "$config_file" ]]; then
        read -r -p "$config_file already exists. Re-run gen-config? [y/N] " ans
        [[ "$ans" =~ ^[Yy]$ ]] || { stderr "init aborted"; return 0; }
    fi

    stderr "initializing dococ project..."
    
    # Run gen-config
    do_gen_config
    
    # Check if config was created
    if [[ ! -f "$config_file" ]]; then
        stderr "gen-config failed to create $config_file"
        return 1
    fi

    # Run update to build the image
    stderr "building container image..."
    do_update
    
    stderr "project initialized successfully"
    stderr "run 'dococ' to start opencode"
}

# ---------------------------------------------------------------------------
# Container creation and run
# ---------------------------------------------------------------------------

# Compute the hash component for a project directory.
project_hash() {
    printf '%s' "$1" | cksum | awk '{print $1}'
}

# Stable container name for a project directory: dococ-<dirname>-<short hash>.
project_container_name() {
    local dir="$1"
    local base hash
    base="$(basename "$dir")"
    hash="$(project_hash "$dir")"
    printf 'dococ-%s-%s' "$base" "$hash"
}

# Per-project image tag: dococ/opencode:<hash>
project_image_tag() {
    printf 'dococ/opencode:%s' "$(project_hash "$1")"
}

# Does a docker container with the given name exist (in any state)?
container_exists() {
    docker ps -a --format '{{.Names}}' | grep -qxF "$1"
}

# List every dococ container belonging to a project, oldest first.
project_containers() {
    docker ps -a --filter "label=dococ.project=$1" --format '{{.Names}}'
}

# running or stopped for a container name.
container_state() {
    if [[ "$(docker inspect -f '{{.State.Running}}' "$1" </dev/null)" == "true" ]]; then
        printf 'running'
    else
        printf 'stopped'
    fi
}

# Retire the canonical container so a fresh one can take its name. The old
# container is preserved (renamed) rather than destroyed.
retire_container() {
    local name="$1"
    local retired
    retired="${name}.retired-$(date +%s)-$$"
    stderr "retiring container '$name' as '$retired'"
    docker rename "$name" "$retired" </dev/null
}

# Interactive --pick: list the project's containers and let the user choose one
# to exec into (including a "new container" option). Prints the chosen container
# name on stdout, or the empty string for "new container".
pick_container() {
    local project="$1"
    local base="$2"
    local -a names=()
    local -a labels=()
    local i name state

    mapfile -t names < <(project_containers "$project")
    if (( ${#names[@]} )); then
        for i in "${!names[@]}"; do
            name="${names[$i]}"
            state="$(container_state "$name")"
            labels+=("$i) $name ($state)")
            printf '%d) %s (%s)\n' "$i" "$name" "$state" >&2
        done
        printf '%d) (new container)\n' "${#names[@]}" >&2
    else
        stderr "no existing containers for this project"
        printf '%d) (new container)\n' "0" >&2
        names=()
    fi

    printf 'choose: ' >&2
    read -r i </dev/tty || die "no selection (stdin closed)"

    if [[ -z "$i" ]]; then
        die "no container selected"
    fi

    if (( i == ${#names[@]} )); then
        printf 'NEW'
        return 0
    fi

    if (( i < 0 || i >= ${#names[@]} )); then
        die "invalid selection: $i"
    fi

    printf '%s' "${names[$i]}"
}

# When --isolated is set, redirect the opencode data/state/cache mounts to
# per-project dirs (seeded from the real ones) so each project's sessions are
# isolated while config and auth stay available. Mutates DOCOC_OPENCODE_*.
prepare_isolated_data() {
    local project_dir="$1"
    local hash base root
    base="$(basename "$project_dir")"
    hash="$(printf '%s' "$project_dir" | cksum | awk '{print $1}')"
    root="$DOCOC_DATA_DIR/$base-$hash"

    mkdir -p "$root/share" "$root/state" "$root/cache"

    # Seed the isolated data dir with the real auth.json so the container can
    # still reach providers, but starts with a clean session database.
    # opencode config stays shared via its own read-only mount.
    [[ -f "$DOCOC_OPENCODE_DATA/auth.json" ]] \
        && cp -f "$DOCOC_OPENCODE_DATA/auth.json" "$root/share/auth.json"

    # Swap the mount sources to the isolated dirs.
    DOCOC_OPENCODE_DATA="$root/share"
    DOCOC_OPENCODE_STATE="$root/state"
    DOCOC_OPENCODE_CACHE="$root/cache"

    stderr "isolated opencode data: $root"
}

# Build the -v mounts shared by every dococ container. Appends user-specified
# mounts and mount-files afterwards. Uses global-state builder output var.
build_mounts() {
    local src
    core_mounts=()
    # Core opencode state (read-only config, rw data/state/cache), mounted at
    # the container-home paths opencode actually reads via $HOME.
    [[ -d "$DOCOC_OPENCODE_CONFIG" ]] \
        && core_mounts+=("-v" "$DOCOC_OPENCODE_CONFIG:$DOCOC_C_CONFIG:ro")
    [[ -d "$DOCOC_OPENCODE_DATA" ]] \
        && core_mounts+=("-v" "$DOCOC_OPENCODE_DATA:$DOCOC_C_DATA")
    # Credentials are read only: the agent may use its own keys but must not be
    # able to rewrite them (prevent tampering/redirect of provider endpoints).
    # The file mount overlays the rw data-dir mount, so only auth.json is ro
    # while the session DB below it stays writable.
    [[ -f "$DOCOC_OPENCODE_DATA/auth.json" ]] \
        && core_mounts+=("-v" "$DOCOC_OPENCODE_DATA/auth.json:$DOCOC_C_DATA/auth.json:ro")
    [[ -d "$DOCOC_OPENCODE_STATE" ]] \
        && core_mounts+=("-v" "$DOCOC_OPENCODE_STATE:$DOCOC_C_STATE")
    # The cache directory is read-write so opencode can create its temporary
    # models catalog (models.json.<n>.tmp) and write quota state, but the
    # executable plugin/LSP directories (node_modules, packages, bin) are
    # overlaid read-only to keep their code immutable. A compromised agent
    # can tamper with cache data but not with installed plugin binaries.
    [[ -d "$DOCOC_OPENCODE_CACHE" ]] \
        && core_mounts+=("-v" "$DOCOC_OPENCODE_CACHE:$DOCOC_C_CACHE")
    [[ -d "$DOCOC_OPENCODE_CACHE/node_modules" ]] \
        && core_mounts+=("-v" "$DOCOC_OPENCODE_CACHE/node_modules:$DOCOC_C_CACHE/node_modules:ro")
    [[ -d "$DOCOC_OPENCODE_CACHE/packages" ]] \
        && core_mounts+=("-v" "$DOCOC_OPENCODE_CACHE/packages:$DOCOC_C_CACHE/packages:ro")
    [[ -d "$DOCOC_OPENCODE_CACHE/bin" ]] \
        && core_mounts+=("-v" "$DOCOC_OPENCODE_CACHE/bin:$DOCOC_C_CACHE/bin:ro")
    # Agent skills (and any future harness assets), read-only.
    [[ -d "$DOCOC_AGENTS_DIR" ]] \
        && core_mounts+=("-v" "$DOCOC_AGENTS_DIR:$DOCOC_C_AGENTS:ro")
    # Project directory. Mount at the host absolute path so sessions created
    # on the host (which record the host-absolute path) can be resumed in the
    # container, and vice versa. This is also the container's working directory.
    core_mounts+=("-v" "$DOCOC_PROJECT_DIR:$DOCOC_PROJECT_DIR")
    # User-requested mounts.
    for mount_spec in "${DOCOC_MOUNTS[@]}"; do
        # Parse mount spec: source[:destination[:options]]
        local src dst opts
        IFS=':' read -r src dst opts <<< "$mount_spec"
        src="$(readlink -f "$src")"
        [[ -e "$src" ]] || die "mount path does not exist: $src"
        if [[ -n "$dst" ]]; then
            core_mounts+=("-v" "$src:$dst${opts:+:$opts}")
        else
            core_mounts+=("-v" "$src:$src")
        fi
    done
    for src in "${DOCOC_MOUNT_FILES[@]}"; do
        src="$(readlink -f "$src")"
        [[ -f "$src" ]] || die "mount-file not found: $src"
        core_mounts+=("-v" "$src:$src:ro")
    done
}

# Create a detached, persistent container for the project and return its name.
# Uses `sleep infinity` as the keep-alive process so the container stays up for
# `docker exec` across invocations.
create_container() {
    local name="$1"
    declare -a args=(
        run -d --name "$name"
        --label "dococ.project=$DOCOC_PROJECT_DIR"
        --label "dococ.workdir=$DOCOC_WORKDIR"
        --label "dococ.isolated=$DOCOC_ISOLATED"
        --label "dococ.mountv=$DOCOC_MOUNT_VERSION"
        --user "$(id -u):$(id -g)"
        --workdir "$DOCOC_WORKDIR"
        --cap-drop ALL
        --security-opt no-new-privileges
        -e "HOME=$DOCOC_CONTAINER_HOME"
    )

    if [[ "$DOCOC_OFFLINE" = 1 ]]; then
        args+=(--network none)
    fi

    for e in "${DOCOC_ENV[@]}"; do
        args+=(-e "$e")
    done

    build_mounts
    args+=("${core_mounts[@]}")

    args+=("$DOCOC_IMAGE" "sleep" "infinity")

    docker "${args[@]}"
}

do_run() {
    local name
    DOCOC_PROJECT_DIR="$(pwd)"
    DOCOC_WORKDIR="$DOCOC_PROJECT_DIR"
    name="$(project_container_name "$DOCOC_PROJECT_DIR")"

    command -v docker >/dev/null 2>&1 || die "docker not found in PATH"

    if [[ "$DOCOC_ISOLATED" = 1 ]]; then
        prepare_isolated_data "$DOCOC_PROJECT_DIR"
    fi

    # --replace: destroy every container for this project, then create fresh.
    if [[ "$DOCOC_REPLACE" = 1 ]]; then
        local old
        mapfile -t old < <(project_containers "$DOCOC_PROJECT_DIR")
        for c in "${old[@]}"; do
            [[ -n "$c" ]] || continue
            stderr "removing container '$c' (--replace)"
            docker rm -f "$c" >/dev/null </dev/null
        done
    # --new: keep the existing container (retire it under a new name) and
    # create a fresh one with the canonical name.
    elif [[ "$DOCOC_NEW" = 1 ]]; then
        if container_exists "$name"; then
            retire_container "$name"
        fi
    # --pick: use a specific container for this invocation (one-shot; the
    # canonical name stays unchanged). With a NAME, select it directly; print
    # NEW from the interactive list to create a fresh one (retiring the base).
    elif [[ "$DOCOC_PICK" = 1 ]]; then
        local picked
        if [[ -n "$DOCOC_PICK_NAME" ]]; then
            if ! container_exists "$DOCOC_PICK_NAME"; then
                die "no such container: $DOCOC_PICK_NAME"
            fi
            picked="$DOCOC_PICK_NAME"
        else
            picked="$(pick_container "$DOCOC_PROJECT_DIR" "$name")"
            if [[ "$picked" == "NEW" ]]; then
                if container_exists "$name"; then
                    retire_container "$name"
                fi
                picked=""
            fi
        fi
        if [[ -n "$picked" ]]; then
            name="$picked"
        fi
    # Default: reuse the canonical container, recreating it if its isolation
    # mode or mount layout no longer matches (mounts differ, so it is unusable).
    elif container_exists "$name"; then
        local existing_iso existing_mountv
        existing_iso="$(docker inspect -f '{{index .Config.Labels "dococ.isolated"}}' "$name" </dev/null)"
        existing_mountv="$(docker inspect -f '{{index .Config.Labels "dococ.mountv"}}' "$name" </dev/null)"
        if [[ "$existing_iso" != "$DOCOC_ISOLATED" ]]; then
            stderr "recreating '$name' (isolation changed)"
            docker rm -f "$name" >/dev/null </dev/null
        elif [[ "$existing_mountv" != "$DOCOC_MOUNT_VERSION" ]]; then
            stderr "recreating '$name' (mount layout changed)"
            docker rm -f "$name" >/dev/null </dev/null
        fi
    fi

    if ! container_exists "$name"; then
        stderr "creating container '$name'..."
        create_container "$name"
        stderr "container '$name' created"
    elif [[ "$(docker inspect -f '{{.State.Running}}' "$name" </dev/null)" != "true" ]]; then
        stderr "starting stopped container '$name'..."
        docker start "$name" >/dev/null </dev/null
    fi

    if [[ -n "$DOCOC_COMMAND" ]]; then
        set +e
        if [[ -t 0 ]]; then
            docker exec -it "$name" bash -lc "$DOCOC_COMMAND"
        else
            docker exec -i "$name" bash -lc "$DOCOC_COMMAND"
        fi
        local rc=$?
        set -e
    else
        set +e
        if [[ -t 0 ]]; then
            docker exec -it "$name" opencode
        else
            docker exec -i "$name" opencode
        fi
        local rc=$?
        set -e
    fi

    if [[ "$DOCOC_REMOVE" = 1 ]]; then
        stderr "removing container '$name' (--rm)"
        docker rm -f "$name" >/dev/null
    fi

    return "$rc"
}

# ---------------------------------------------------------------------------
# Entry point
# ---------------------------------------------------------------------------

main() {
    DOCOC_SUBCOMMAND="run"

    # Load config: global first, then per-project (precedence over global).
    load_config "$DOCOC_GLOBAL_CONFIG"
    load_config "$DOCOC_PROJECT_CONFIG"

    # Determine image tag:
    # - If DOCOC_IMAGE was explicitly set in environment, use it.
    # - Else if apt packages declared or project config exists, use per-project image.
    # - Else use base image (global config only).
    if (( DOCOC_IMAGE_EXPLICIT )); then
        # User explicitly set a custom image; use as-is.
        :
    elif (( ${#DOCOC_APT_PACKAGES[@]} > 0 )) || [[ -f "$DOCOC_PROJECT_CONFIG" ]]; then
        DOCOC_PROJECT_DIR="${DOCOC_PROJECT_DIR:-$PWD}"
        DOCOC_IMAGE="$(project_image_tag "$DOCOC_PROJECT_DIR")"
    else
        # No per-project packages/config; use base image tag.
        DOCOC_IMAGE="dococ/opencode:base"
    fi

    parse_args "$@"

    case "$DOCOC_SUBCOMMAND" in
        init)      do_init ;;
        list)      do_list ;;
        status)    do_status ;;
        clean)     do_clean ;;
        update)    do_update ;;
        gen-config) do_gen_config ;;
        images)    do_images ;;
        run)       do_run ;;
        *)         die "unknown subcommand: $DOCOC_SUBCOMMAND" ;;
    esac
}

main "$@"
